# Contoh variabel lingkungan.
#
# JANGAN menyalin berkas ini menjadi .env lalu meng-commit-nya. Kunci yang
# sekali masuk ke riwayat Git tetap ada di sana meskipun berkasnya dihapus
# pada commit berikutnya. Di platform hosting, isi nilai-nilai ini lewat
# halaman pengaturan Environment, bukan lewat berkas di repo.

# Wajib di produksi

# Aplikasi menolak start tanpa ini saat FLASK_ENV=production. Ini disengaja:
# lebih baik gagal saat start dengan pesan yang jelas daripada berjalan dengan
# kunci karangan yang berbeda di tiap worker.
#
# Hasilkan dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
MBG_SECRET_KEY=ganti-dengan-kunci-acak-64-karakter

# Sangat dianjurkan

# Penanda rilis, dipakai gerbang alur penjelasan. Nilainya harus sama di
# seluruh worker dan berubah pada tiap deploy.
#
# Kebanyakan platform sudah menyediakannya sendiri dan config.py membacanya
# otomatis: RENDER_GIT_COMMIT, RAILWAY_GIT_COMMIT_SHA, SOURCE_COMMIT, atau
# FLY_MACHINE_VERSION. Isi ini hanya bila platform tidak menyediakannya.
# MBG_RILIS=

# Jumlah proxy tepercaya di depan aplikasi.
#
# Nilainya menentukan berapa entri terakhir pada X-Forwarded-For yang dipercaya.
# Terlalu tinggi berarti siapa pun bisa memilih alamat IP-nya sendiri dan
# pembatas laju kehilangan maknanya. Terlalu rendah berarti seluruh pengunjung
# dihitung sebagai satu alamat.
#
#   0  aplikasi diakses langsung (bawaan, paling aman)
#   1  di belakang satu proxy: Nginx, atau load balancer Render/Railway
#   2  di belakang dua lapis, misalnya Cloudflare di depan platform
#
# Cara memeriksa: buka aplikasi lewat proxy, lalu bandingkan alamat yang
# tercatat di log akses dengan alamat asli Anda. Kalau yang tercatat 127.0.0.1,
# 10.x.x.x, atau alamat lain milik platform, angkanya masih terlalu rendah.
#
# Pada Render nilainya 3, diperoleh dari pengujian di layanan yang berjalan:
#   1 -> alamat router internal, berganti tiap permintaan
#   2 -> alamat tepi Cloudflare
#   3 -> alamat ISP pengunjung
MBG_TRUSTED_PROXIES=3

# Opsional

FLASK_ENV=production

# PORT biasanya disuntikkan platform. Isi hanya untuk menjalankan container
# secara manual.
# PORT=5000

# Jumlah proses worker. Baca alasan angka satu di gunicorn.conf.py sebelum
# menaikkannya: status alur dan pembatas laju masih disimpan per proses.
WEB_CONCURRENCY=1
MBG_THREADS=8

# Batas permintaan per alamat IP per menit. Angka ini berlaku per worker.
MBG_RATE_LIMIT=240

MBG_LOG_LEVEL=INFO

# Jalur basis data. Bawaan sudah menunjuk ke data/ di dalam image, jadi ini
# hanya perlu diisi pada jalur deploy VPS.
# MBG_DB_PATH=/opt/mbg/app/data/mbg_recommendations_provinsi.db
